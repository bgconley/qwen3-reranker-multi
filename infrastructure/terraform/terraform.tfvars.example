# Terraform variables for Lambda Cloud deployment
# Copy this file to terraform.tfvars and fill in your values
#
# SECURITY: Never commit terraform.tfvars to version control!
#           It contains sensitive credentials.

# =============================================================================
# Required Variables
# =============================================================================

# Lambda Cloud API key
# Recommended: set via env var instead:
#   export LAMBDALABS_API_KEY="..."
# Fallback (less secure; stored in Terraform state):
# lambda_api_key = "your-lambda-api-key"

# Name of the SSH key you've uploaded to Lambda Cloud
# Create/view keys at: https://cloud.lambdalabs.com/ssh-keys
ssh_key_name = "your-ssh-key-name"

# Path to your local SSH private key (for Terraform provisioning)
ssh_private_key_path = "~/.ssh/id_ed25519"

# Tailscale auth key for unattended setup
# Generate at: https://login.tailscale.com/admin/settings/keys
# Recommended settings:
#   - Reusable: No (one-time use)
#   - Ephemeral: Yes (auto-remove when instance terminates)
#   - Pre-approved: Yes (skip manual device approval)
#   - Tags: tag:servers (optional, for ACL policies)
#
# Preferred: put the key in a local file and point Terraform at it so it never
# ends up in Terraform state.
# Example:
#   mkdir -p ~/.config/qwen3-reranker
#   printf '%s' 'tskey-auth-xxxxxxxx...' > ~/.config/qwen3-reranker/tailscale-auth-key
#   chmod 600 ~/.config/qwen3-reranker/tailscale-auth-key
tailscale_auth_key_path = "~/.config/qwen3-reranker/tailscale-auth-key"

# Fallback (less secure; stored in Terraform state):
# tailscale_auth_key = "tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# Optional: Instance Configuration
# =============================================================================

# Instance name (appears in Lambda Cloud dashboard and Tailscale)
instance_name = "qwen3-reranker"

# GPU instance type
# Options: gpu_1x_a10, gpu_1x_h100_pcie, gpu_1x_a100_sxm, gpu_8x_a100_sxm, etc.
# See: https://docs.lambda.ai/public-cloud/on-demand/
instance_type = "gpu_1x_a10"

# Region
# Options: us-west-1, us-east-1, us-south-1, europe-central-1, asia-northeast-1
region = "us-west-1"

# =============================================================================
# Optional: Reranker Configuration
# =============================================================================

# Reranker profile (from config/reranker_profiles.yaml)
# Options: qwen3_4b_cuda, qwen3_4b_vllm, qwen3_4b_mps, etc.
reranker_profile = "qwen3_4b_cuda"

# Backend to use
# Options: pytorch (recommended), vllm, auto
reranker_backend = "pytorch"

# Port for the reranker service
reranker_port = 9003

# =============================================================================
# Optional: Git Repository
# =============================================================================

# Git repository to clone (update to your fork/repo)
git_repo_url = "https://github.com/yourusername/qwen3-reranker-multi.git"

# Branch to checkout
git_branch = "master"

# =============================================================================
# Optional: Tailscale Configuration
# =============================================================================

# Hostname for the Tailscale node (used in MagicDNS)
# Access the reranker at: http://<tailscale_hostname>:9003
tailscale_hostname = "qwen3-reranker"

# Tailscale tags (requires ACL configuration in your tailnet)
# Example: ["tag:servers", "tag:gpu"]
tailscale_tags = []

# =============================================================================
# Optional: Persistent Storage
# =============================================================================

# Attach an existing persistent filesystem for model cache
# This prevents re-downloading the ~8GB model on each deploy
attach_filesystem = true

# Name for the filesystem (appears in Lambda Cloud dashboard)
filesystem_name = "qwen3-reranker-cache"
